# Dependency and local files to exclude from version control

# Environment variables — never commit real secrets
.env
.env.local
.env.production
backend/.env

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

# Python / backend
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/venv/
backend/*.pyc
backend/*.pyo
*.egg-info/
.pytest_cache/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor config
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads (should go to Supabase Storage, not the repo)
uploads/
