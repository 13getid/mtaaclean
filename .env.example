# Environment Variables Template
# Copy this file to .env.local (frontend) and backend/.env (backend)
# Fill in your real values. NEVER commit files with real secrets to git.

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (.env.local)
# Variables prefixed with VITE_ are bundled into the browser build.
# Do NOT place secret keys in VITE_ variables.
# =============================================================================

# Clerk publishable key (safe to expose — it's not a secret)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key

# Supabase project URL (safe to expose — access is controlled by RLS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon key (safe to expose — access is controlled by RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_with_your_anon_key

# URL of the FastAPI backend (change for production)
VITE_API_BASE_URL=http://localhost:8000

# Map tile URL template (OpenStreetMap default — check usage policy for production)
# For production, consider: https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Map tile attribution (required by OpenStreetMap licence)
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# =============================================================================
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# These are SECRET. Never expose them in frontend code or commit them to git.
# =============================================================================

# Clerk secret key (SECRET — backend only)
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Clerk publishable key (used for JWKS URL construction)
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key

# Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service-role key (SECRET — bypasses RLS — backend only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_with_your_service_role_key

# Comma-separated list of allowed frontend origins (for CORS)
ALLOWED_ORIGINS=http://localhost:5173

# Name of the Supabase Storage bucket for report photos
STORAGE_BUCKET=report-photos

# Signed URL expiry in seconds (default: 3600 = 1 hour)
SIGNED_URL_EXPIRY_SECONDS=3600

# Clerk webhook signing secret (from the Clerk dashboard webhook settings)
CLERK_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
